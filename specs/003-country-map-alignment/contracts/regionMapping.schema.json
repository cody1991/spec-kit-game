{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spec-kit-game.local/schemas/region-mapping.schema.json",
  "title": "Region-to-Country Mapping Schema",
  "description": "JSON Schema for validating region-to-country mapping configuration",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/definitions/RegionMapping"
  },
  "definitions": {
    "RegionMapping": {
      "type": "object",
      "required": ["id", "name", "countryIds"],
      "properties": {
        "id": {
          "type": "string",
          "description": "旧的区域 ID（如 'china', 'western-europe'）",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 2,
          "maxLength": 30
        },
        "name": {
          "type": "string",
          "description": "区域的显示名称（中文）",
          "minLength": 2,
          "maxLength": 20
        },
        "nameEn": {
          "type": "string",
          "description": "区域的英文名称（可选）",
          "minLength": 2,
          "maxLength": 50
        },
        "countryIds": {
          "type": "array",
          "description": "ISO 3166-1 numeric codes 列表",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{3}$",
            "description": "3位数字的 ISO 3166-1 numeric code"
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "description": "地理范围的详细说明（可选）",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    [
      {
        "id": "china",
        "name": "中国",
        "nameEn": "China",
        "countryIds": ["156"],
        "description": "东亚地区，中华人民共和国"
      },
      {
        "id": "western-europe",
        "name": "西欧",
        "nameEn": "Western Europe",
        "countryIds": ["250", "276", "380", "528", "56", "442", "724"],
        "description": "西欧地区，包括法国、德国、意大利、荷兰、比利时、卢森堡、西班牙"
      }
    ]
  ]
}
